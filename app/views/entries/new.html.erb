<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm mt-4">
      <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Create a New Entry</h3>
      </div>
      
      <div class="card-body">
        <%= form_with(model: @entry) do |form| %>
          
          <div class="mb-3">
            <%= form.label :name, class: "form-label fw-bold" %>
            <%= form.text_field :name, class: "form-control", placeholder: "Name now?" %>
          </div>

          <div class="mb-4">
            <%= form.label :link, "Link", class: "form-label fw-bold" %>
            <%= form.text_field :link, class: "form-control", placeholder: "https://..." %>
          </div>

          <div class="d-grid">
            <%= form.submit "Save Entry", class: "btn btn-primary btn-lg" %>
          </div>

        <% end %>
      </div>
      
      <div class="card-footer text-center bg-light">
        <%= link_to "Cancel and go back", root_path, class: "text-decoration-none text-secondary" %>
      </div>
    </div>
  </div>
</div>