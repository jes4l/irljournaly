<% if @entry.images.count > @entry.splats.count %>
  <meta http-equiv="refresh" content="3">
<% end %>
<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between mb-3 px-5">
    <%= link_to "< Back to Calendar", entries_path, class: "btn btn-outline-dark fw-bold rounded-pill" %>
    <div class="d-flex gap-2">
      <% if @entry.images.attached? %>
        <% if @entry.images.count == @entry.splats.count %>
          <button class="btn btn-primary fw-bold rounded-pill shadow" onclick="document.getElementById('splat-overlay').classList.add('active')">
            <i class="bi bi-box-arrow-in-right me-1"></i> Step into Journal
          </button>
        <% else %>
          <button class="btn btn-secondary fw-bold rounded-pill shadow" disabled>
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            Generating (<%= @entry.images.count - @entry.splats.count %> remaining)...
          </button>
        <% end %>
      <% end %>
      <% if @entry.created_at.to_date == Date.today %>
        <%= link_to "Edit Today's Journal", new_entry_path, class: "btn btn-dark fw-bold rounded-pill" %>
      <% end %>
    </div>
  </div>
  <div class="journal-container">
    <div class="journal-book read-only-book">
      <div class="position-absolute top-0 start-0 m-4 p-3 border border-dark rounded bg-white shadow-sm text-center z-3" style="font-family: 'Patrick Hand', cursive; line-height: 1;">
        <div style="font-size: 3.5rem; font-weight: bold;"><%= @entry.created_at.strftime("%d") %></div>
        <div style="font-size: 1.5rem;"><%= @entry.created_at.strftime("%B '%y") %></div>
      </div>
      <div class="journal-page w-100 h-100 position-absolute top-0 start-0">
        <%== @entry.content %>
      </div>
    </div>
  </div>
</div>
<% if @entry.splats.attached? && @entry.images.count == @entry.splats.count %>
  <div id="splat-overlay" class="splat-overlay" data-controller="splat-viewer" data-splat-viewer-urls-value="<%= @entry.splats.map { |s| rails_blob_path(s, only_path: true) }.to_json %>">
    <button class="btn-close-splat" onclick="document.getElementById('splat-overlay').classList.remove('active')">
      <i class="bi bi-x-lg"></i>
    </button>
    <button class="btn-reset-splat" data-action="click->splat-viewer#resetCamera">
      <i class="bi bi-arrow-counterclockwise"></i>
    </button>
    <% if @entry.splats.count > 1 %>
      <button class="btn-nav-splat btn-prev" data-action="click->splat-viewer#prev" data-splat-viewer-target="prevBtn" style="display: none;">
        <i class="bi bi-chevron-left"></i>
      </button>
      <button class="btn-nav-splat btn-next" data-action="click->splat-viewer#next" data-splat-viewer-target="nextBtn">
        <i class="bi bi-chevron-right"></i>
      </button>
    <% end %>
    <div class="splat-slider-viewport">
      <div class="splat-slider-track" data-splat-viewer-target="track"></div>
    </div>
  </div>
<% end %>