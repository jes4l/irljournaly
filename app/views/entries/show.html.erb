<% 
  valid_images = @entry.images
  processed_splats = @entry.splats.select { |splat| valid_images.any? { |img| splat.filename.to_s.start_with?("#{img.id}.") } }
  valid_splats = @entry.splats.select { |splat| splat.filename.to_s.end_with?(".ply") }
  stuck_images = valid_images.select { |img| img.created_at < 30.minutes.ago && !processed_splats.any? { |s| s.filename.to_s.start_with?("#{img.id}.") } }
  remaining_splats = [0, valid_images.count - processed_splats.count - stuck_images.count].max
%>

<% if remaining_splats > 0 %>
  <meta http-equiv="refresh" content="10">
<% end %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<div class="journal-container" data-controller="journal-downloader" data-refresh="<%= remaining_splats > 0 %>">
  <div class="d-flex w-100 justify-content-between align-items-center px-1 py-2 flex-wrap" style="max-width: 1300px; gap: 5px;">
    <%= link_to "< Back", entries_path, class: "btn btn-outline-dark fw-bold rounded-3 btn-sm px-2 px-md-3" %>
    <div class="viewer-actions">
      <% if valid_images.any? %>
        <% if remaining_splats == 0 %>
          <% if valid_splats.any? %>
            <button class="btn btn-primary fw-bold rounded-3 shadow btn-sm px-2 px-md-3" onclick="document.getElementById('splat-overlay').classList.add('active')">
              <i class="bi bi-box-arrow-in-right me-1"></i> Step into Journal
            </button>
          <% else %>
            <button class="btn btn-secondary fw-bold rounded-3 shadow btn-sm px-2 px-md-3" disabled><i class="bi bi-x-circle me-1"></i> Failed</button>
          <% end %>
        <% else %>
          <button class="btn btn-secondary fw-bold rounded-3 shadow btn-sm px-2 px-md-3" disabled><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Generating...</button>
         <% end %>
      <% end %>
      <% if @entry.created_at.to_date == Date.today %>
        <%= link_to new_entry_path, class: "btn btn-dark fw-bold rounded-3 btn-sm px-2 px-md-3" do %>
          <i class="bi bi-pencil me-1"></i> Edit Today
        <% end %>
      <% end %>
      <button class="btn btn-success fw-bold rounded-3 shadow btn-sm px-2 px-md-3" data-action="click->journal-downloader#download" title="Download Journal as Image">
        <i class="bi bi-download me-1"></i> Download
      </button>
    </div>
  </div>

  <div class="journal-book read-only-book" id="journal-book-download-target">
    <div class="journal-sticker">
      <div class="sticker-day"><%= @entry.created_at.strftime("%d") %></div>
      <div class="sticker-month"><%= @entry.created_at.strftime("%B '%y") %></div>
      <% if @entry.sentiment.present? %>
        <div class="mt-2 badge <%= @entry.sentiment == 'Good' ? 'bg-success' : (@entry.sentiment == 'Bad' ? 'bg-danger' : 'bg-secondary') %> text-white border border-dark sticker-mood">
          Mood: <%= @entry.sentiment %>
        </div>
      <% end %>
    </div>
    
    <% posted_image_ids = CommunityPost.where(original_image_id: valid_images.map(&:id)).pluck(:original_image_id) %>
    <div class="journal-page" data-controller="journal-viewer" data-journal-viewer-target="canvas" data-journal-viewer-posted-ids-value="<%= posted_image_ids.to_json %>">
      <%== @entry.content %>
    </div>
  </div>
</div>

<% if valid_splats.any? && remaining_splats == 0 %>
  <div id="splat-overlay" class="splat-overlay" data-controller="splat-viewer" data-splat-viewer-urls-value="<%= valid_splats.map { |s| rails_blob_path(s, only_path: true) }.to_json %>" data-splat-viewer-image-urls-value="<%= valid_images.map { |img| rails_blob_path(img, only_path: true) }.to_json %>">
    <button class="btn-close-splat" onclick="document.getElementById('splat-overlay').classList.remove('active'); if(window.speechSynthesis) window.speechSynthesis.cancel(); document.querySelectorAll('audio, video').forEach(m => m.pause());"><i class="bi bi-x-lg"></i></button>
    <div class="position-absolute start-50 translate-middle-x d-flex align-items-center gap-3 z-3 splat-controls-container">
      <button class="btn btn-light rounded-circle shadow d-flex align-items-center justify-content-center hover-scale" style="width: 55px; height: 55px; border: 2px solid #212529;" data-action="click->splat-viewer#resetCamera"><i class="bi bi-arrow-counterclockwise fs-4 text-dark"></i></button>
      <div data-controller="transcript-player" data-transcript-player-entry-id-value="<%= @entry.id %>" data-transcript-player-original-text-value="<%= strip_tags(@entry.content).gsub("&nbsp;", " ").strip.gsub('"', '&quot;') %>">
        <div class="bg-light rounded-pill shadow d-flex align-items-center px-2" style="height: 55px; border: 2px solid #212529; transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);">
          <button class="btn btn-light rounded-circle d-flex align-items-center justify-content-center border-0 p-0" style="width: 40px; height: 40px; outline: none; box-shadow: none;" data-action="click->transcript-player#togglePlay" data-transcript-player-target="playBtn" aria-label="Play Audio">
            <i class="bi bi-play-fill fs-2 text-dark"></i>
          </button>
          <div class="tts-controls d-flex align-items-center overflow-hidden" data-transcript-player-target="ttsControls" style="width: 0; opacity: 0; transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);">
            <span class="mx-2 small fw-bold text-muted" data-transcript-player-target="timeDisplay" style="white-space: nowrap; font-family: sans-serif; font-size: 0.85rem;">0:00 / 0:00</span>
            <input type="range" class="form-range custom-range mx-1" min="0" max="100" value="0" style="width: 140px; cursor: pointer;" data-transcript-player-target="progressBar" data-action="input->transcript-player#dragProgress change->transcript-player#seekTTS">
            <button class="btn btn-sm text-secondary p-0 ms-1 me-1 hover-scale" data-action="click->transcript-player#minimizeTTS" aria-label="Minimize Audio Player">
              <i class="bi bi-x-circle-fill fs-5 text-dark"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
    <% if valid_splats.count > 1 %>
      <button class="btn-nav-splat btn-prev" data-action="click->splat-viewer#prev" data-splat-viewer-target="prevBtn" style="display: none;"><i class="bi bi-chevron-left"></i></button>
      <button class="btn-nav-splat btn-next" data-action="click->splat-viewer#next" data-splat-viewer-target="nextBtn"><i class="bi bi-chevron-right"></i></button>
    <% end %>
    <div class="splat-slider-viewport"><div class="splat-slider-track" data-splat-viewer-target="track"></div></div>
  </div>
<% end %>