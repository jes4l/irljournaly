<% 
  valid_images = @entry.images
  
  processed_splats = @entry.splats.select do |splat|
    valid_images.any? { |img| splat.filename.to_s.start_with?("#{img.id}.") }
  end

  valid_splats = @entry.splats.select do |splat|
    splat.filename.to_s.end_with?(".ply")
  end

  stuck_images = valid_images.select do |img| 
    img.created_at < 30.minutes.ago && !processed_splats.any? { |s| s.filename.to_s.start_with?("#{img.id}.") }
  end

  remaining_splats = [0, valid_images.count - processed_splats.count - stuck_images.count].max
%>

<% if remaining_splats > 0 %>
  <meta http-equiv="refresh" content="10">
<% end %>

<div class="container-fluid mt-4">
  <div class="d-flex flex-column flex-md-row justify-content-between mb-3 px-2 px-md-5 gap-2">
    <%= link_to "< Back to Calendar", entries_path, class: "btn btn-outline-dark fw-bold rounded-3" %>
    <div class="d-flex flex-column flex-md-row gap-2">
      <% if valid_images.any? %>
        <% if remaining_splats == 0 %>
          <% if valid_splats.any? %>
            <button class="btn btn-primary fw-bold rounded-3 shadow" onclick="document.getElementById('splat-overlay').classList.add('active')">
              <i class="bi bi-box-arrow-in-right me-1"></i> Step into Journal
            </button>
          <% else %>
            <button class="btn btn-secondary fw-bold rounded-3 shadow" disabled>
              <i class="bi bi-x-circle me-1"></i> 3D Generation Failed
            </button>
          <% end %>
        <% else %>
          <button class="btn btn-secondary fw-bold rounded-3 shadow" disabled>
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            Generating (<%= remaining_splats %> remaining)...
          </button>
         <% end %>
      <% end %>
      <% if @entry.created_at.to_date == Date.today %>
        <%= link_to "Edit Today's Journal", new_entry_path, class: "btn btn-dark fw-bold rounded-3" %>
      <% end %>
    </div>
  </div>
  <div class="journal-container">
    <div class="journal-book read-only-book">
      <div class="position-absolute top-0 start-0 m-2 m-md-4 p-2 p-md-3 border border-dark rounded bg-white shadow-sm text-center z-3" style="font-family: 'Patrick Hand', cursive; line-height: 1;">
        <div class="fw-bold" style="font-size: clamp(2rem, 5vw, 3.5rem);"><%= @entry.created_at.strftime("%d") %></div>
        <div style="font-size: clamp(1rem, 3vw, 1.5rem);"><%= @entry.created_at.strftime("%B '%y") %></div>
        
        <% if @entry.sentiment.present? %>
          <div class="mt-2 badge <%= @entry.sentiment == 'Good' ? 'bg-success' : (@entry.sentiment == 'Bad' ? 'bg-danger' : 'bg-secondary') %> fs-6 shadow-sm border border-dark">
            Mood: <%= @entry.sentiment %>
          </div>
        <% end %>
      </div>
      <div class="journal-page w-100 h-100 position-absolute top-0 start-0">
        <%== @entry.content %>
      </div>
    </div>
  </div>
</div>

<% if valid_splats.any? && remaining_splats == 0 %>
  <div id="splat-overlay" class="splat-overlay" data-controller="splat-viewer" 
       data-splat-viewer-urls-value="<%= valid_splats.map { |s| rails_blob_path(s, only_path: true) }.to_json %>"
       data-splat-viewer-image-urls-value="<%= valid_images.map { |img| rails_blob_path(img, only_path: true) }.to_json %>">
       
    <button class="btn-close-splat" onclick="document.getElementById('splat-overlay').classList.remove('active')" aria-label="Close Splat Viewer">
      <i class="bi bi-x-lg"></i>
    </button>

    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4 d-flex align-items-center gap-3 z-3">
      
      <button class="btn btn-light rounded-circle shadow d-flex align-items-center justify-content-center hover-scale" style="width: 55px; height: 55px; border: 2px solid #212529;" data-action="click->splat-viewer#resetCamera" aria-label="Reset Camera">
        <i class="bi bi-arrow-counterclockwise fs-4 text-dark"></i>
      </button>

      <div data-controller="transcript-player"
           data-transcript-player-entry-id-value="<%= @entry.id %>"
           data-transcript-player-original-text-value="<%= strip_tags(@entry.content).gsub("&nbsp;", " ").strip.gsub('"', '&quot;') %>">
        
        <div class="bg-light rounded-pill shadow d-flex align-items-center px-2" style="height: 55px; border: 2px solid #212529; transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);">
          <button class="btn btn-light rounded-circle d-flex align-items-center justify-content-center border-0 p-0" style="width: 40px; height: 40px; outline: none; box-shadow: none;" data-action="click->transcript-player#togglePlay" data-transcript-player-target="playBtn" aria-label="Play Audio">
            <i class="bi bi-play-fill fs-2 text-dark"></i>
          </button>

          <div class="tts-controls d-flex align-items-center overflow-hidden" data-transcript-player-target="ttsControls" style="width: 0; opacity: 0; transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);">
            <span class="mx-2 small fw-bold text-muted" data-transcript-player-target="timeDisplay" style="white-space: nowrap; font-family: sans-serif; font-size: 0.85rem;">0:00 / 0:00</span>
            <input type="range" class="form-range custom-range mx-1" min="0" max="100" value="0" style="width: 140px; cursor: pointer;" data-transcript-player-target="progressBar" data-action="input->transcript-player#dragProgress change->transcript-player#seekTTS">
            
            <button class="btn btn-sm text-secondary p-0 ms-1 me-1 hover-scale" data-action="click->transcript-player#minimizeTTS" aria-label="Minimize Audio Player">
              <i class="bi bi-x-circle-fill fs-5 text-dark"></i>
            </button>
          </div>
        </div>

      </div>
    </div>

    <% if valid_splats.count > 1 %>
      <button class="btn-nav-splat btn-prev" data-action="click->splat-viewer#prev" data-splat-viewer-target="prevBtn" style="display: none;" aria-label="Previous Splat">
        <i class="bi bi-chevron-left"></i>
      </button>
      <button class="btn-nav-splat btn-next" data-action="click->splat-viewer#next" data-splat-viewer-target="nextBtn" aria-label="Next Splat">
        <i class="bi bi-chevron-right"></i>
      </button>
    <% end %>
    
    <div class="splat-slider-viewport">
      <div class="splat-slider-track" data-splat-viewer-target="track"></div>
    </div>
  </div>
<% end %>