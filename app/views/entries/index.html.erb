<% 
  start_date = @current_date.beginning_of_month.beginning_of_week(:sunday)
  end_date = @current_date.end_of_month.end_of_week(:sunday)
  date_range = (start_date..end_date).to_a
%>

<div class="container mt-4 mb-5" style="max-width: 800px;">
  
  <div class="d-flex justify-content-center align-items-center mb-4 gap-4">
    <%= link_to "<", entries_path(date: @current_date.prev_month), class: "text-dark text-decoration-none fs-1 fw-bold hover-scale" %>
    <h1 style="font-size: 4rem; font-weight: bold; margin: 0;"><%= @current_date.strftime("%B %Y") %></h1>
    <%= link_to ">", entries_path(date: @current_date.next_month), class: "text-dark text-decoration-none fs-1 fw-bold hover-scale" %>
  </div>
  
  <div class="row text-center calendar-header mb-2 mx-1 border-0">
    <div class="col">Sun</div>
    <div class="col">Mon</div>
    <div class="col">Tue</div>
    <div class="col">Wed</div>
    <div class="col">Thu</div>
    <div class="col">Fri</div>
    <div class="col">Sat</div>
  </div>
  
  <% date_range.each_slice(7) do |week| %>
    <div class="row mx-1">
      <% week.each do |day| %>
        <div class="col p-0 m-1">
          <% if day.month == @current_date.month %>
            <% entry = @entries_by_date[day] %>
            
            <% if entry %>
              <%= link_to entry_path(entry), class: "text-decoration-none text-white" do %>
                <div class="rounded calendar-day d-flex justify-content-center align-items-center bg-success shadow-sm border border-dark hover-scale">
                  <span class="fw-bold fs-2"><%= day.day %></span>
                </div>
              <% end %>
            <% else %>
              <div class="rounded calendar-day d-flex justify-content-center align-items-center bg-white shadow-sm border border-dark">
                <span class="fw-bold fs-2 text-dark"><%= day.day %></span>
              </div>
            <% end %>
            
          <% else %>
            <div class="calendar-day-empty"></div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>