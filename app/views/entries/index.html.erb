<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="text-primary">All Entries</h1>
  <%= link_to "Add New Entry", new_entry_path, class: "btn btn-success" %>
</div>

<div class="table-responsive shadow-sm rounded">
  <table class="table table-striped table-hover align-middle mb-0">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Link</th>
        <th>Images</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @entries.each do |entry| %>
        <tr>
          <td class="fw-bold"><%= entry.name %></td>
          <td>
            <% if entry.link.present? %>
              <%= link_to entry.link, entry.link, target: "_blank", class: "text-decoration-none" %>
            <% else %>
              <span class="text-muted">No link provided</span>
            <% end %>
          </td>
          <td>
            <% if entry.images.attached? %>
              <div class="d-flex flex-wrap gap-2">
                <% entry.images.each do |image| %>
                  <%= image_tag image, style: "width: 80px; height: 80px; object-fit: cover;", class: "rounded border shadow-sm" %>
                <% end %>
              </div>
            <% else %>
              <span class="text-muted">No images</span>
            <% end %>
          </td>
          <td class="text-end">
            <%= button_to "Delete", entry, method: :delete, data: { confirm: "Are you sure you want to delete this Project?", turbo_confirm: "Are you sure you want to delete this Project?" }, class: "btn btn-danger btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>