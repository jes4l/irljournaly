<div class="container mt-4 mb-5">
  <h1 class="text-center fw-bold mb-5" style="font-family: 'Patrick Hand', cursive; font-size: clamp(2.5rem, 6vw, 4rem);">Community Gallery</h1>
  
  <% if @posts.empty? %>
    <div class="text-center text-muted fs-4 mt-5">
      No one has posted any images yet! Be the first!
    </div>
  <% end %>

  <div class="community-masonry">
    <% @posts.each do |post| %>
      <div class="community-masonry-item position-relative overflow-hidden group-hover rounded-4 shadow-sm" tabindex="0" style="cursor: pointer;">
        
        <% if post.user_id == current_user.id %>
          <%= button_to community_post_path(post), method: :delete, class: "btn btn-danger btn-sm position-absolute top-0 end-0 m-2 shadow z-3 rounded-circle delete-post-btn", data: { confirm: "Delete this post?" }, style: "width: 35px; height: 35px;" do %>
            <i class="bi bi-trash"></i>
          <% end %>
        <% end %>

        <%= image_tag post.image, class: "w-100 h-auto d-block" if post.image.attached? %>
        
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex flex-column justify-content-center align-items-center hover-opacity-100" style="z-index: 2;">
          <div class="text-white fw-bold fs-4 mb-3 text-center px-2" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.8);">
            Shared by <%= post.user.first_name || 'Anonymous' %>
          </div>
          
          <% if post.splat.attached? %>
            <%= link_to community_post_path(post), class: "btn btn-primary btn-lg fw-bold rounded-pill shadow hover-scale" do %>
              <i class="bi bi-box-arrow-in-right me-1"></i> Step In
            <% end %>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>
</div>